# Copy this file to .env in the same folder and fill in your real values.
# .env is gitignored - never commit real credentials.

# Atlas dashboard -> Database -> Connect -> Drivers -> copy the connection
# string, then substitute your database user's username/password into it.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database name to store borrowers/loans/payments in. Created automatically
# on first write - no need to pre-create it in Atlas.
MONGODB_DB=simple_interest_calculator

# Port this API server listens on.
PORT=4000
